YOUCAM_API_KEY=
RAPIDAPI_KEY=

# Postgres: local Docker (docker compose up -d) for dev, Neon pooled connection string in prod
DATABASE_URL=postgresql://ensemble:ensemble@localhost:5432/ensemble

# Usage cap. The YouCam key is a fixed pool of units and one look burns three or four, so
# each visitor gets a limited number of looks per rolling window. Set the limit to 0 to
# disable the cap entirely (useful when recording a demo).
YOUCAM_LOOK_LIMIT=3
YOUCAM_QUOTA_WINDOW_HOURS=6

# Catalog images. ASOS's CDN 403s datacenter IPs, so the try-on cannot fetch garment photos from
# it on Vercel - the images are mirrored to Cloudinary instead (scripts/upload-catalog-images.mjs).
# NEXT_PUBLIC_CATALOG_CDN is read at build time, so set it in the Vercel env before deploying.
# Unset it to fall back to the copies in public/catalog.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CATALOG_CDN=https://res.cloudinary.com/<cloud-name>/image/upload/ensemble/catalog
